{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ResumeModel",
  "type": "object",
  "required": [
    "colors",
    "contact"
  ],
  "properties": {
    "colors": {
      "$ref": "#/definitions/ResumeColors"
    },
    "contact": {
      "$ref": "#/definitions/ContactInforation"
    },
    "image": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "mainText": {
      "type": "string"
    },
    "employers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Employer"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SkillGroup"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SideSection"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FontInfo"
      }
    },
    "anonymous": {
      "type": "boolean"
    }
  },
  "definitions": {
    "ResumeColors": {
      "type": "object",
      "properties": {
        "main": {
          "type": "string"
        },
        "mainTextColor": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "muted": {
          "type": "string"
        }
      }
    },
    "ContactInforation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "github": {
          "type": "string"
        }
      }
    },
    "Employer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "engagements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Engagement"
          }
        }
      }
    },
    "Engagement": {
      "type": "object",
      "properties": {
        "client": {
          "type": [
            "null",
            "string"
          ]
        },
        "role": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SkillGroup": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SideSection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FontInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    }
  }
}